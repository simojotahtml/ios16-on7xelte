From: j7 performance
Subject: j7prime: scale framebuffer copy workers to active CPUs

The lockscreen currently reaches scanout through the CPU framebuffer path. Reuse
the row-band copier from the HEROLTE port on A5XELTE builds, choosing up to three
helper threads from the CPUs XNU actually brought online. That gives one helper
on a two-CPU boot and up to three on the J7's eight-CPU profile.
sweetfb_copythreads=0 keeps the serial memcpy path; a positive override can lower
the automatic count but is capped below the number of active CPUs and at the
worker-array limit. This speeds only the final framebuffer copy, not CoreAnimation's
software rendering, and remains a candidate until measured on the phone.

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -53,6 +53,7 @@
 #include <kern/thread.h>
+#include <machine/machine_routines.h>
 #include <sys/proc.h>
 
-#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+#if defined(ARM64_BOARD_CONFIG_HEROLTE) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 static void sweet_fb_copy_init(void);
 #endif
@@ -272,6 +272,6 @@ AppleCLCD::start(IOService *provider)
 	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
 #endif
-#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+#if defined(ARM64_BOARD_CONFIG_HEROLTE) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 	sweet_fb_copy_init();
 #endif
 	fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
@@ -411,5 +411,5 @@ static uint32_t sweet_fb_swaps_logged;
 static uint64_t sweet_fb_swap_count;
 
-#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+#if defined(ARM64_BOARD_CONFIG_HEROLTE) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 /*
  * A full 1440x2560 frame is 14.7 MB into write-combined memory: 10-20 ms
@@ -477,3 +477,11 @@ sweet_fb_copy_init(void)
 {
-	uint32_t helpers = 3;
+	uint32_t cpu_count = ml_get_cpu_count();
+	uint32_t max_helpers = cpu_count > 1 ? cpu_count - 1 : 0;
+	if (max_helpers > SWEET_FB_COPY_MAX_HELPERS) {
+		max_helpers = SWEET_FB_COPY_MAX_HELPERS;
+	}
+	uint32_t helpers = max_helpers;
 	PE_parse_boot_argn("sweetfb_copythreads", &helpers, sizeof(helpers));
+	if (helpers > max_helpers) {
+		helpers = max_helpers;
+	}
@@ -698,5 +698,5 @@ AppleCLCD::present(const uint8_t *rec)
 		} else if (src != 0 && bpe == 4) {
 			copied += (uint64_t)w * (uint64_t)h * 4;
-#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+#if defined(ARM64_BOARD_CONFIG_HEROLTE) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 			sweet_fb_copy_rows(fPixels + (uint64_t)dy * fRowBytes + (uint64_t)dx * 4, fRowBytes,
 			    src + s->offset + (uint64_t)sy * s->bytesPerRow + (uint64_t)sx * 4, s->bytesPerRow,
